# CQ 1: Which options serve the cash-collection goal, and which instrument does each use?
PREFIX choice: <http://example.org/ontology/choice/>
PREFIX uco-core: <https://ontology.unifiedcyberontology.org/uco/core/>

SELECT ?option ?name ?instrument
WHERE {
    ?option a choice:Option ;
            choice:servesGoal ?goal ;
            choice:usesInstrument ?instrument ;
            uco-core:name ?name .
    ?goal uco-core:name "Move the directed cash from the victim to the runners" .
}
# ---
# CQ 2: Which transition enacted each option?
PREFIX choice: <http://example.org/ontology/choice/>
PREFIX traj: <http://example.org/ontology/trajectories/>

SELECT ?option ?transition
WHERE {
    ?option a choice:Option ;
            choice:enactedTransition ?transition .
    ?transition a traj:Transition .
}
# ---
# CQ 3: For each option serving the cash-collection goal, what friction
# levels were assessed, and which activity produced the assessment?
PREFIX choice: <http://example.org/ontology/choice/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX uco-core: <https://ontology.unifiedcyberontology.org/uco/core/>

SELECT ?option ?identityFriction ?delayBurden ?detectionExposure ?resourceCost ?activity
WHERE {
    ?option a choice:Option ;
            choice:servesGoal ?goal .
    ?goal uco-core:name "Move the directed cash from the victim to the runners" .
    ?assessment a choice:OptionAssessment ;
                choice:assessesOption ?option ;
                choice:identityFriction ?identityFriction ;
                choice:delayBurden ?delayBurden ;
                choice:detectionExposure ?detectionExposure ;
                choice:resourceCost ?resourceCost ;
                prov:wasGeneratedBy ?activity .
}
# ---
# CQ 4: What identity-friction level was assessed for each option?
PREFIX choice: <http://example.org/ontology/choice/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?option ?friction
WHERE {
    ?assessment a choice:OptionAssessment ;
                choice:assessesOption ?option ;
                choice:identityFriction ?friction ;
                prov:wasGeneratedBy ?activity .
}
