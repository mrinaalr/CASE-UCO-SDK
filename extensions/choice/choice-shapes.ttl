# Choice extension — SHACL
# Observed Option / Goal / OffenderCapability cite evidence.
# Inferred OptionAssessment and Selection cite a generating activity.

@prefix choice: <http://example.org/ontology/choice/> .
@prefix traj: <http://example.org/ontology/trajectories/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

choice:Goal-shape
	a sh:NodeShape ;
	sh:targetClass choice:Goal ;
	sh:property
		[
			sh:path choice:pursuedBy ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:IRI ;
			sh:message "A Goal MUST name the actor who pursues it."@en ;
		] .

choice:Option-shape
	a sh:NodeShape ;
	sh:targetClass choice:Option ;
	sh:message "An Option is an observed means for a goal at a state."@en ;
	sh:property
		[
			sh:path choice:servesGoal ;
			sh:class choice:Goal ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:availableAt ;
			sh:class traj:State ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:usesInstrument ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:enactedTransition ;
			sh:class traj:Transition ;
			sh:maxCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path prov:wasDerivedFrom ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
			sh:message "Every Option MUST cite the source that names this means."@en ;
		] ;
	sh:sparql
		[
			a sh:SPARQLConstraint ;
			sh:message "The action a walked option's transition enacts must carry that option's usesInstrument on uco-action:instrument."@en ;
			sh:select """
				PREFIX choice: <http://example.org/ontology/choice/>
				PREFIX traj: <http://example.org/ontology/trajectories/>
				PREFIX uco-action: <https://ontology.unifiedcyberontology.org/uco/action/>
				SELECT $this ?instrument
				WHERE {
					$this choice:enactedTransition ?transition ;
						choice:usesInstrument ?instrument .
					?transition traj:enactsAction ?action .
					FILTER NOT EXISTS { ?action uco-action:instrument ?instrument }
				}
				""" ;
		] ;
	sh:not
		[
			sh:or (
				[ sh:class choice:OptionAssessment ]
				[ sh:class choice:Selection ]
			) ;
			sh:message "An Option must not also be typed OptionAssessment or Selection."@en ;
		] .

choice:OptionAssessment-shape
	a sh:NodeShape ;
	sh:targetClass choice:OptionAssessment ;
	sh:message "An OptionAssessment is an inferred friction and feasibility reading."@en ;
	sh:property
		[
			sh:path choice:assessesOption ;
			sh:class choice:Option ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:identityFriction ;
			sh:datatype xsd:string ;
			sh:in ( "low" "moderate" "high" "not_in_source" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:property
		[
			sh:path choice:delayBurden ;
			sh:datatype xsd:string ;
			sh:in ( "low" "moderate" "high" "not_in_source" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:property
		[
			sh:path choice:detectionExposure ;
			sh:datatype xsd:string ;
			sh:in ( "low" "moderate" "high" "not_in_source" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:property
		[
			sh:path choice:resourceCost ;
			sh:datatype xsd:string ;
			sh:in ( "low" "moderate" "high" "not_in_source" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:property
		[
			sh:path choice:feasibility ;
			sh:datatype xsd:string ;
			sh:in ( "feasible" "removed" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:property
		[
			sh:path prov:wasGeneratedBy ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
			sh:message "Every OptionAssessment MUST carry prov:wasGeneratedBy."@en ;
		] ;
	sh:not
		[
			sh:or (
				[ sh:class choice:Option ]
				[ sh:class traj:PhaseAssertion ]
			) ;
			sh:message "An OptionAssessment must not also be typed Option or PhaseAssertion."@en ;
		] .

choice:OffenderCapability-shape
	a sh:NodeShape ;
	sh:targetClass choice:OffenderCapability ;
	sh:property
		[
			sh:path choice:possessedBy ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:enablesOption ;
			sh:class choice:Option ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path prov:wasDerivedFrom ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
		] .

choice:Constraint-shape
	a sh:NodeShape ;
	sh:targetClass choice:Constraint ;
	sh:property
		[
			sh:path choice:removesOption ;
			sh:class choice:Option ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:constraintKind ;
			sh:datatype xsd:string ;
			sh:in ( "wall" "guardian" "access_denial" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:sparql
		[
			a sh:SPARQLConstraint ;
			sh:message "An option removed by a Constraint must be assessed feasibility removed."@en ;
			sh:select """
				PREFIX choice: <http://example.org/ontology/choice/>
				SELECT $this ?assessment
				WHERE {
					$this choice:removesOption ?option .
					?assessment a choice:OptionAssessment ;
						choice:assessesOption ?option ;
						choice:feasibility ?feasibility .
					FILTER(?feasibility != "removed")
				}
				""" ;
		] .

choice:Selection-shape
	a sh:NodeShape ;
	sh:targetClass choice:Selection ;
	sh:message "A Selection is an inferred choice from a menu. It carries no reward."@en ;
	sh:property
		[
			sh:path choice:selectsOption ;
			sh:class choice:Option ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:IRI ;
		] ;
	sh:property
		[
			sh:path choice:amongOptions ;
			sh:class choice:Option ;
			sh:minCount 2 ;
			sh:nodeKind sh:IRI ;
			sh:message "A Selection MUST name at least two options."@en ;
		] ;
	sh:property
		[
			sh:path choice:selectionRule ;
			sh:datatype xsd:string ;
			sh:in ( "not_modeled" "satisficing" "discrete_choice" "opportunistic" ) ;
			sh:minCount 1 ;
			sh:maxCount 1 ;
			sh:nodeKind sh:Literal ;
		] ;
	sh:property
		[
			sh:path prov:wasGeneratedBy ;
			sh:minCount 1 ;
			sh:nodeKind sh:IRI ;
			sh:message "Every Selection MUST carry prov:wasGeneratedBy."@en ;
		] ;
	sh:sparql
		[
			a sh:SPARQLConstraint ;
			sh:message "choice:selectsOption must also appear as choice:amongOptions."@en ;
			sh:select """
				PREFIX choice: <http://example.org/ontology/choice/>
				SELECT $this ?option
				WHERE {
					$this choice:selectsOption ?option .
					FILTER NOT EXISTS { $this choice:amongOptions ?option }
				}
				""" ;
		] ;
	sh:not
		[
			sh:or (
				[ sh:class choice:Option ]
				[ sh:class traj:PhaseAssertion ]
			) ;
			sh:message "A Selection must not also be typed Option or PhaseAssertion."@en ;
		] .
