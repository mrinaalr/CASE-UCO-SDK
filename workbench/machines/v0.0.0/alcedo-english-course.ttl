al:charge-1951 a legalproc:FederalCharge ;
	uco-core:name "Extortion counts" ;
	uco-core:description "Counts 13–18, 18 U.S.C. § 1951(a). Payments and one call, each alleged to rest in part on a threat of arrest, deportation, or other immigration consequences. No consumer initial is recorded." ;
