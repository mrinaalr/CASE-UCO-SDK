# v0.0.0 machine — phone / script / commercial-carrier consumer fraud
# United States v. Carla Magaly Alcedo Mendoza, S.D. Fla. 1:21-cr-20328
# Source: public indictment, CourtListener document 438504917 (15 pages).
# Occupancies are CHARGING ALLEGATIONS (manner and means), not findings of fact.
# Confidence 55 means "stated in this public charging instrument." It is not a verdict.
# Conspiracy window on every occupancy: the indictment does not date each phase separately.
# Terminal polarity "completed" is the charging theory's endpoint (payment obtained),
# not an adjudicated result for a named victim.

@prefix al: <http://example.org/kb/fraud-v0/alcedo/> .
@prefix traj: <http://example.org/ontology/trajectories/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix case-investigation: <https://ontology.caseontology.org/case/investigation/> .
@prefix legalproc: <https://ontology.caseontology.org/case/criminal/> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix uco-location: <https://ontology.unifiedcyberontology.org/uco/location/> .
@prefix uco-victim: <https://ontology.unifiedcyberontology.org/uco/victim/> .

#################################################################
# Provenance
#################################################################

al:doc-438504917
	a uco-core:UcoObject ;
	uco-core:name "Indictment, United States v. Alcedo Mendoza, S.D. Fla. 1:21-cr-20328" ;
	uco-core:description "Public indictment as to Carla Magaly Alcedo Mendoza, Document 3, entered 2021-06-04. CourtListener document_id 438504917. https://www.courtlistener.com/docket/70056460/3/united-states-v-alcedo-mendoza/ Local copy: workbench/casenoesis-data/collected/recap/fraud/438504917.pdf. Counts include 18 U.S.C. 1349, 1341, 1343, 1951(a). NHSR: UMass HRPO NHSR #8252 (16 Sep 2026). v0.0.0 read the conspiracy window (¶2) and manner and means (¶¶4–11)." .

al:evidence-manner
	a uco-core:UcoObject ;
	uco-core:name "Manner and means, English-course telephone scheme" ;
	uco-core:description "Indictment ¶¶4–11, as read for v0.0.0. She owned Bussines A.A.D.; obtained names and contacts of Spanish-speaking U.S. consumers; telephone calls offered English-language courses and a false claim of university plus U.S. government financial assistance; a second call said the consumer was selected; callers impersonated lawyers and U.S. court officers; a false FedEx storage-fee and lawsuit story; threats of arrest and immigration harm; call scripts collected country of origin and immigration status; co-conspirators in the U.S. mailed packages (English courses or tablets, not of the value represented) via FedEx; payment by credit or prepaid cards." .

al:activity-list-acquisition
	a prov:Activity ;
	uco-core:name "Pre-s0: obtain Spanish-speaking consumer contact lists" ;
	uco-core:description "Exogenous feeder, not a traj:State. The indictment alleges names and contacts were obtained before the scripted calls. Not dated separately from the January 2013–December 2018 conspiracy window." ;
	prov:used al:evidence-manner .

#################################################################
# Domain alphabet (A-box states, not new classes)
#################################################################

al:alphabet
	a skos:ConceptScheme ;
	uco-core:name "Alcedo English-course pathway alphabet (v0.0.0)" ;
	uco-core:description "Phone-era consumer fraud. Instruments are the telephone, a script, a commercial carrier, and a payment card. No platform or app." .

al:ScriptedOffer a traj:State , skos:Concept ;
	skos:inScheme al:alphabet ; skos:prefLabel "ScriptedOffer"@en ;
	uco-core:description "Telephone offer of English courses tied to a false claim of university and U.S. government financial assistance." .
al:SelectionFiction a traj:State , skos:Concept ;
	skos:inScheme al:alphabet ; skos:prefLabel "SelectionFiction"@en ;
	uco-core:description "A second call telling the consumer they were selected." .
al:AuthorityThreat a traj:State , skos:Concept ;
	skos:inScheme al:alphabet ; skos:prefLabel "AuthorityThreat"@en ;
	uco-core:description "Impersonation of lawyers and court officers, a storage-fee and lawsuit fiction, and threats of arrest and immigration harm. Scripts collect country of origin and immigration status. The leverage is language and immigration status, not age." .
al:CarrierDelivery a traj:State , skos:Concept ;
	skos:inScheme al:alphabet ; skos:prefLabel "CarrierDelivery"@en ;
	uco-core:description "Co-conspirators mail English courses or tablets via FedEx. The goods are not of the value represented." .
al:CardPayment a traj:State , skos:Concept ;
	skos:inScheme al:alphabet ; skos:prefLabel "CardPayment"@en ;
	uco-core:description "Payment by credit or prepaid card. Charging-theory endpoint." .

#################################################################
# Tech instruments and enacted actions
#################################################################

al:inst-telephone a uco-observable:PhoneAccount ;
	uco-core:name "Telephone" ;
	uco-core:description "The indictment's contact channel. It does not allege VoIP, spoofing, or a messaging app." .
al:inst-script a uco-observable:File ;
	uco-core:name "Call script collecting origin and immigration status" ;
	uco-core:description "Scripts used to collect country of origin and immigration status and to deliver the assistance and threat story." .
al:inst-fedex a uco-identity:Organization ;
	uco-core:name "FedEx" ;
	uco-core:description "Commercial interstate carrier used to deliver the courses or tablets and as the prop in the storage-fee fiction." .
al:inst-card a uco-observable:PaymentCard ;
	uco-core:name "Credit or prepaid card" ;
	uco-core:description "Payment instrument alleged for the extraction." .

al:act-scripted-call a uco-action:Action ;
	uco-core:name "Place scripted eligibility call" ;
	uco-action:instrument al:inst-telephone , al:inst-script ;
	prov:wasDerivedFrom al:evidence-manner .
al:act-selection-call a uco-action:Action ;
	uco-core:name "Place selection call" ;
	uco-action:instrument al:inst-telephone ;
	prov:wasDerivedFrom al:evidence-manner .
al:act-impersonate-and-threaten a uco-action:Action ;
	uco-core:name "Impersonate court actors and threaten arrest or immigration harm" ;
	uco-action:instrument al:inst-telephone , al:inst-script ;
	prov:wasDerivedFrom al:evidence-manner .
al:act-ship-package a uco-action:Action ;
	uco-core:name "Ship course or tablet via FedEx" ;
	uco-action:instrument al:inst-fedex ;
	prov:wasDerivedFrom al:evidence-manner .
al:act-take-card a uco-action:Action ;
	uco-core:name "Take credit or prepaid-card payment" ;
	uco-action:instrument al:inst-card ;
	prov:wasDerivedFrom al:evidence-manner .

#################################################################
# Interval (conspiracy window, not per-phase dates)
#################################################################

al:interval-conspiracy a time:ProperInterval ;
	time:hasBeginning al:instant-start ;
	time:hasEnd al:instant-end .
al:instant-start a time:Instant ; time:inXSDDateTimeStamp "2013-01-01T00:00:00Z"^^xsd:dateTimeStamp .
al:instant-end a time:Instant ; time:inXSDDateTimeStamp "2018-12-31T23:59:00Z"^^xsd:dateTimeStamp .

al:confidence-0 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
al:confidence-1 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
al:confidence-2 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
al:confidence-3 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
al:confidence-4 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .

#################################################################
# Observed occupancies (one scheme trajectory; individual consumers are not separated)
#################################################################

al:phase-0 a traj:PhaseAssertion ;
	uco-core:name "Occupancy 0 — scripted offer" ;
	uco-core:description "Charging allegation. Telephone offer of English courses and false university / government assistance. Fed by list acquisition (pre-s0). Source: indictment ¶¶4–11." ;
	traj:assertsState al:ScriptedOffer ;
	traj:atInterval al:interval-conspiracy ;
	traj:sequenceIndex "0"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom al:evidence-manner ;
	uco-core:hasFacet al:confidence-0 .

al:phase-1 a traj:PhaseAssertion ;
	uco-core:name "Occupancy 1 — selection fiction" ;
	uco-core:description "Charging allegation. A second call says the consumer was selected. Source: indictment manner and means." ;
	traj:assertsState al:SelectionFiction ;
	traj:atInterval al:interval-conspiracy ;
	traj:sequenceIndex "1"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom al:evidence-manner ;
	uco-core:hasFacet al:confidence-1 .

al:phase-2 a traj:PhaseAssertion ;
	uco-core:name "Occupancy 2 — authority impersonation and threat" ;
	uco-core:description "Charging allegation. Impersonation of lawyers and U.S. court officers, FedEx storage-fee / lawsuit fiction, threats of arrest and immigration harm. Source: indictment manner and means." ;
	traj:assertsState al:AuthorityThreat ;
	traj:atInterval al:interval-conspiracy ;
	traj:sequenceIndex "2"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom al:evidence-manner ;
	uco-core:hasFacet al:confidence-2 .

al:phase-3 a traj:PhaseAssertion ;
	uco-core:name "Occupancy 3 — carrier delivery" ;
	uco-core:description "Charging allegation. Packages mailed via FedEx. Source: indictment manner and means." ;
	traj:assertsState al:CarrierDelivery ;
	traj:atInterval al:interval-conspiracy ;
	traj:sequenceIndex "3"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom al:evidence-manner ;
	uco-core:hasFacet al:confidence-3 .

al:phase-4 a traj:PhaseAssertion ;
	uco-core:name "Occupancy 4 — card payment" ;
	uco-core:description "Charging allegation. Payment by credit or prepaid card. traj:terminalPolarity completed marks the charging theory's extraction endpoint, not a verdict and not a named consumer's proven path." ;
	traj:assertsState al:CardPayment ;
	traj:atInterval al:interval-conspiracy ;
	traj:sequenceIndex "4"^^xsd:nonNegativeInteger ;
	traj:isTerminal true ;
	traj:terminalPolarity "completed" ;
	prov:wasDerivedFrom al:evidence-manner ;
	uco-core:hasFacet al:confidence-4 .

al:trajectory-scheme
	a traj:Trajectory ;
	uco-core:name "Alcedo English-course scheme trajectory (v0.0.0)" ;
	uco-core:description "One scheme-level path, January 2013 through December 2018, as charged. Individual consumers are not split out. Tech stack: telephone, script, FedEx, payment card." ;
	traj:hasPhaseAssertion al:phase-0 , al:phase-1 , al:phase-2 , al:phase-3 , al:phase-4 .

#################################################################
# Charged edges (manner-and-means order). Not transition probabilities.
#################################################################

al:t-offer-selection a traj:Transition ;
	uco-core:name "Scripted offer to selection fiction" ;
	traj:fromState al:ScriptedOffer ;
	traj:toState al:SelectionFiction ;
	traj:trigger al:evidence-manner ;
	traj:enactsAction al:act-selection-call ;
	uco-core:description "Indictment order: a second call after the course offer. No estimated probability." .
al:t-selection-threat a traj:Transition ;
	uco-core:name "Selection fiction to authority threat" ;
	traj:fromState al:SelectionFiction ;
	traj:toState al:AuthorityThreat ;
	traj:trigger al:evidence-manner ;
	traj:enactsAction al:act-impersonate-and-threaten ;
	uco-core:description "Indictment order: impersonation and immigration/arrest threats after the selection claim." .
al:t-threat-delivery a traj:Transition ;
	uco-core:name "Authority threat to carrier delivery" ;
	traj:fromState al:AuthorityThreat ;
	traj:toState al:CarrierDelivery ;
	traj:trigger al:evidence-manner ;
	traj:enactsAction al:act-ship-package ;
	uco-core:description "Indictment order: FedEx delivery of the course or tablet." .
al:t-delivery-payment a traj:Transition ;
	uco-core:name "Carrier delivery to card payment" ;
	traj:fromState al:CarrierDelivery ;
	traj:toState al:CardPayment ;
	traj:trigger al:evidence-manner ;
	traj:enactsAction al:act-take-card ;
	uco-core:description "Indictment order: payment by credit or prepaid card." .

#################################################################
# Inferred SEP extraction test. Not a charging allegation.
# Premises are the manner-and-means already asserted above.
# Unfairness is not evaluated. Not a verdict.
#################################################################

al:sep-run a prov:Activity ;
	uco-core:name "SEP extraction test" ;
	uco-core:description "Source-versus-target derivation. A preexisting object that changes hands and keeps its value is victim-sourced. The benefit being the victim's absence is victim-targeted. Unfairness is not scored." .

al:anat-payment a traj:BenefitAnatomy ;
	uco-core:name "Card payment drawn from the consumer" ;
	uco-core:description "Manner and means: payment by credit or prepaid card. The consumer is the source of that payment. The script's use of language and immigration status is leverage in the narrative; this test does not score it as unfairness." ;
	traj:onTransition al:t-delivery-payment ;
	traj:transferredObject "credit or prepaid-card payment" ;
	traj:preexisting true ;
	traj:valueSurvivesVictim true ;
	traj:anatomyRule "The payment predates the call and keeps its value after the consumer is off the line. The benefit is the payment, not the consumer's removal." ;
	traj:suppliedByPerson true ;
	traj:personRetainsValue false ;
	traj:requiresPresence false ;
	traj:advantageDefect "deception" ;
	traj:benefitSource "victim_sourced" ;
	prov:wasGeneratedBy al:sep-run .

al:sep-scheme a traj:ExploitationAssessment ;
	uco-core:name "Alcedo scheme extraction test" ;
	uco-core:description "Goal-realizing edge is the card payment. Anatomy derives victim_sourced, so the extraction test passes." ;
	traj:assessesTrajectory al:trajectory-scheme ;
	traj:goalRealizingTransition al:t-delivery-payment ;
	traj:hasBenefitAnatomy al:anat-payment ;
	traj:extractionTestStatus "realized_at_expense" ;
	traj:passesExtractionTest true ;
	traj:passesExploitationTest true ;
	traj:exploitationOnset al:interval-conspiracy ;
	prov:wasGeneratedBy al:sep-run .

