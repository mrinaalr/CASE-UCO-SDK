# CASE/UCO context layer
# Overview and the three scheme descriptions. Other names in the
# public copy are redacted and are not reconstructed.
#################################################################

ob:charge-doc a legalproc:ChargingInstrument ;
	uco-core:name "Indictment, United States v. Obaseki" ;
	legalproc:instrumentType "indictment" ;
	uco-core:description "Filed 2022-11-10. CourtListener 217799634. Redacted public copy." ;
	prov:wasDerivedFrom ob:doc-217799634 .
ob:charge-1343 a legalproc:FederalCharge ;
	uco-core:name "Conspiracy to commit wire fraud" ;
	legalproc:statuteCitation "18 U.S.C. § 1343" ;
	legalproc:offenseForm "conspiracy" ;
	legalproc:assertedIn ob:charge-doc .
ob:person-obaseki a uco-identity:Person ;
