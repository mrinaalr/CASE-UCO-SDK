cf:doc-141451183 a uco-core:UcoObject ;
	uco-core:name "Criminal complaint, United States v. Cofer, S.D. Fla. 9:20-mj-08273" ;
	uco-core:description "Complaint entered 2020-08-05, CourtListener document_id 141451183. Local copy: workbench/casenoesis-data/collected/recap/fraud/141451183.pdf. Counts 18 U.S.C. 1028A and 1029. NHSR: UMass HRPO NHSR #8252 (16 Sep 2026). v0.0.0 uses the affidavit's description of a home-health aide taking elderly clients' identifying information, accessing accounts, adding a card, depositing stolen checks at an ATM, and recruiting another person to provide a debit card and PIN." .

cf:evidence-affidavit a uco-core:UcoObject ;
	uco-core:name "Cofer affidavit, insider access and account use" ;
	uco-core:description "As read: she worked as a home-health aide; stole client identifying information including name, date of birth, Social Security number, and bank and card information; accessed bank and card accounts; added herself on an account; made purchases; opened accounts; stole a phone and cards. At least five victims, four elderly. A card was approved in her name on one elderly client's American Express account and purchases were made. Stolen checks were deposited at an ATM into another account. She messaged J.N.H. about extra money, asked to use J.N.H.'s bank account, and received J.N.H.'s debit card and PIN. Specific account numbers and the online contact address are omitted here." .

cf:activity-care-role a prov:Activity ;
	uco-core:name "Pre-s0: home-health access to elderly clients" ;
	uco-core:description "The care role is the access that supplies identifying information. It is not a traj:State." ;
	prov:used cf:evidence-affidavit .

cf:alphabet-account a skos:ConceptScheme ; uco-core:name "Cofer account-takeover alphabet" .
cf:PiiTheft a traj:State , skos:Concept ; skos:inScheme cf:alphabet-account ; skos:prefLabel "PiiTheft"@en ;
	uco-core:description "Identifying and account information taken from elderly clients." .
cf:AccountAccess a traj:State , skos:Concept ; skos:inScheme cf:alphabet-account ; skos:prefLabel "AccountAccess"@en ;
	uco-core:description "Unauthorized access to bank and credit-card accounts." .
cf:AddOnCard a traj:State , skos:Concept ; skos:inScheme cf:alphabet-account ; skos:prefLabel "AddOnCard"@en ;
	uco-core:description "A card in her name approved on a client's American Express account." .
cf:Extraction a traj:State , skos:Concept ; skos:inScheme cf:alphabet-account ; skos:prefLabel "Extraction"@en ;
	uco-core:description "Unauthorized purchases and ATM deposits of stolen checks. Charging-theory endpoint for this layer." .

cf:alphabet-mule a skos:ConceptScheme ; uco-core:name "Cofer recruited-account alphabet" .
cf:RecruitMessage a traj:State , skos:Concept ; skos:inScheme cf:alphabet-mule ; skos:prefLabel "RecruitMessage"@en ;
	uco-core:description "A message offering extra money, then a request to use the other person's bank account." .
cf:CredentialHandoff a traj:State , skos:Concept ; skos:inScheme cf:alphabet-mule ; skos:prefLabel "CredentialHandoff"@en ;
	uco-core:description "The other person provided a debit card and PIN." .
cf:CheckDeposit a traj:State , skos:Concept ; skos:inScheme cf:alphabet-mule ; skos:prefLabel "CheckDeposit"@en ;
	uco-core:description "A stolen check was deposited into that account. The affidavit says the card was not returned." .

cf:inst-care a uco-core:UcoObject ; uco-core:name "In-person care access" ;
	uco-core:description "Physical proximity to clients and their records and cards. Not a remote platform." .
cf:inst-bank a uco-observable:Account ; uco-core:name "Bank and card accounts" ;
	uco-core:description "Existing client accounts, an add-on card, and ATM deposit of checks." .
cf:inst-message a uco-observable:Message ; uco-core:name "Message to a recruited account holder" ;
	uco-core:description "The affidavit says she messaged J.N.H. The platform is not named here." .

cf:act-take-pii a uco-action:Action ; uco-core:name "Take client identifying information" ;
	uco-action:instrument cf:inst-care ; prov:wasDerivedFrom cf:evidence-affidavit .
cf:act-access a uco-action:Action ; uco-core:name "Access client accounts" ;
	uco-action:instrument cf:inst-bank ; prov:wasDerivedFrom cf:evidence-affidavit .
cf:act-add-card a uco-action:Action ; uco-core:name "Add a card in her name" ;
	uco-action:instrument cf:inst-bank ; prov:wasDerivedFrom cf:evidence-affidavit .
cf:act-extract a uco-action:Action ; uco-core:name "Spend and deposit" ;
	uco-action:instrument cf:inst-bank ; prov:wasDerivedFrom cf:evidence-affidavit .
cf:act-recruit a uco-action:Action ; uco-core:name "Ask to use another person's account" ;
	uco-action:instrument cf:inst-message ; prov:wasDerivedFrom cf:evidence-affidavit .

cf:interval a time:ProperInterval ; time:hasBeginning cf:t0 ; time:hasEnd cf:t1 .
cf:t0 a time:Instant ; time:inXSDDateTimeStamp "2019-05-01T00:00:00Z"^^xsd:dateTimeStamp .
cf:t1 a time:Instant ; time:inXSDDateTimeStamp "2019-10-24T23:59:00Z"^^xsd:dateTimeStamp .

cf:c0 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
cf:c1 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
cf:c2 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
cf:c3 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
cf:c4 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
cf:c5 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .
cf:c6 a uco-core:ConfidenceFacet ; uco-core:confidence "55"^^xsd:nonNegativeInteger .

cf:p0 a traj:PhaseAssertion ; uco-core:name "Account occupancy 0 — identifying information" ;
	uco-core:description "Charging allegation. Fed by the care role." ;
	traj:assertsState cf:PiiTheft ; traj:atInterval cf:interval ; traj:sequenceIndex "0"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c0 .
cf:p1 a traj:PhaseAssertion ; uco-core:name "Account occupancy 1 — account access" ;
	traj:assertsState cf:AccountAccess ; traj:atInterval cf:interval ; traj:sequenceIndex "1"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c1 .
cf:p2 a traj:PhaseAssertion ; uco-core:name "Account occupancy 2 — add-on card" ;
	traj:assertsState cf:AddOnCard ; traj:atInterval cf:interval ; traj:sequenceIndex "2"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c2 .
cf:p3 a traj:PhaseAssertion ; uco-core:name "Account occupancy 3 — purchases and ATM deposits" ;
	uco-core:description "Charging-theory endpoint for the account layer. Not a verdict." ;
	traj:assertsState cf:Extraction ; traj:atInterval cf:interval ; traj:sequenceIndex "3"^^xsd:nonNegativeInteger ;
	traj:isTerminal true ; traj:terminalPolarity "completed" ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c3 .
cf:traj-account a traj:Trajectory ; uco-core:name "Cofer account-takeover trajectory" ;
	traj:hasPhaseAssertion cf:p0 , cf:p1 , cf:p2 , cf:p3 .
cf:t-access a traj:Transition ; traj:fromState cf:PiiTheft ; traj:toState cf:AccountAccess ; traj:trigger cf:evidence-affidavit ; traj:enactsAction cf:act-access .
cf:t-card a traj:Transition ; traj:fromState cf:AccountAccess ; traj:toState cf:AddOnCard ; traj:trigger cf:evidence-affidavit ; traj:enactsAction cf:act-add-card .
cf:t-extract a traj:Transition ; traj:fromState cf:AddOnCard ; traj:toState cf:Extraction ; traj:trigger cf:evidence-affidavit ; traj:enactsAction cf:act-extract .

cf:m0 a traj:PhaseAssertion ; uco-core:name "Recruit occupancy 0 — message" ;
	traj:assertsState cf:RecruitMessage ; traj:atInterval cf:interval ; traj:sequenceIndex "0"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c4 .
cf:m1 a traj:PhaseAssertion ; uco-core:name "Recruit occupancy 1 — card and PIN" ;
	traj:assertsState cf:CredentialHandoff ; traj:atInterval cf:interval ; traj:sequenceIndex "1"^^xsd:nonNegativeInteger ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c5 .
cf:m2 a traj:PhaseAssertion ; uco-core:name "Recruit occupancy 2 — check deposit" ;
	traj:assertsState cf:CheckDeposit ; traj:atInterval cf:interval ; traj:sequenceIndex "2"^^xsd:nonNegativeInteger ;
	traj:isTerminal true ; traj:terminalPolarity "completed" ;
	prov:wasDerivedFrom cf:evidence-affidavit ; uco-core:hasFacet cf:c6 .
cf:traj-mule a traj:Trajectory ; uco-core:name "Cofer recruited-account trajectory" ;
	traj:hasPhaseAssertion cf:m0 , cf:m1 , cf:m2 .
cf:t-handoff a traj:Transition ; traj:fromState cf:RecruitMessage ; traj:toState cf:CredentialHandoff ; traj:trigger cf:evidence-affidavit ; traj:enactsAction cf:act-recruit .
cf:t-deposit a traj:Transition ; traj:fromState cf:CredentialHandoff ; traj:toState cf:CheckDeposit ; traj:trigger cf:evidence-affidavit ; traj:enactsAction cf:act-extract .

#################################################################
# Inferred SEP extraction test. Care access is context for how
# the accounts were reached. It is not scored as unfairness.
#################################################################

cf:sep-run a prov:Activity ;
	uco-core:name "SEP extraction test" ;
	uco-core:description "Source-versus-target derivation from the affidavit allegations already in this graph. Unfairness is not scored." .

cf:anat-extract a traj:BenefitAnatomy ;
	uco-core:name "Client funds spent and deposited" ;
	uco-core:description "Affidavit: purchases and ATM deposits from client accounts after an add-on card. The client is the source of the funds. In-person care access is how the accounts were reached." ;
	traj:onTransition cf:t-extract ;
	traj:transferredObject "client account funds" ;
	traj:preexisting true ;
	traj:valueSurvivesVictim true ;
	traj:anatomyRule "The funds are already the client's and keep their value once spent or deposited. The benefit is the money, not the client's removal." ;
	traj:suppliedByPerson true ;
	traj:personRetainsValue false ;
	traj:requiresPresence false ;
	traj:advantageDefect "deception" ;
	traj:benefitSource "victim_sourced" ;
	prov:wasGeneratedBy cf:sep-run .

cf:sep-account a traj:ExploitationAssessment ;
	uco-core:name "Cofer account-takeover extraction test" ;
	uco-core:description "Goal-realizing edge is the spend and deposit. Anatomy derives victim_sourced." ;
	traj:assessesTrajectory cf:traj-account ;
	traj:goalRealizingTransition cf:t-extract ;
	traj:hasBenefitAnatomy cf:anat-extract ;
	traj:extractionTestStatus "realized_at_expense" ;
	traj:passesExtractionTest true ;
	traj:passesExploitationTest true ;
	traj:exploitationOnset cf:interval ;
	prov:wasGeneratedBy cf:sep-run .

cf:anat-deposit a traj:BenefitAnatomy ;
	uco-core:name "Client funds through a recruited account" ;
	uco-core:description "Affidavit: a recruited person provides a card and PIN, then a check is deposited. The source of the value is the client instrument, moved through the recruited account." ;
	traj:onTransition cf:t-deposit ;
	traj:transferredObject "client funds deposited through a recruited account" ;
	traj:preexisting true ;
	traj:valueSurvivesVictim true ;
	traj:anatomyRule "The deposited value predates the handoff and survives without removing the client. The recruited account is the channel." ;
	traj:suppliedByPerson true ;
	traj:personRetainsValue false ;
	traj:requiresPresence false ;
	traj:advantageDefect "deception" ;
	traj:benefitSource "victim_sourced" ;
	prov:wasGeneratedBy cf:sep-run .

cf:sep-mule a traj:ExploitationAssessment ;
	uco-core:name "Cofer recruited-account extraction test" ;
	uco-core:description "Goal-realizing edge is the check deposit. Anatomy derives victim_sourced." ;
	traj:assessesTrajectory cf:traj-mule ;
	traj:goalRealizingTransition cf:t-deposit ;
	traj:hasBenefitAnatomy cf:anat-deposit ;
	traj:extractionTestStatus "realized_at_expense" ;
	traj:passesExtractionTest true ;
	traj:passesExploitationTest true ;
	traj:exploitationOnset cf:interval ;
	prov:wasGeneratedBy cf:sep-run .

cf:layer-account a lay:Layer ; uco-core:name "Layer 0 — account takeover" ;
	lay:occupiesTrajectory cf:traj-account ; lay:domainAlphabet cf:alphabet-account ;
	lay:layerIndex "0"^^xsd:nonNegativeInteger ; lay:coverage "partial" ; lay:concurrencyGroup "cofer-2019" .
cf:layer-mule a lay:Layer ; uco-core:name "Layer 1 — recruited account" ;
	lay:occupiesTrajectory cf:traj-mule ; lay:domainAlphabet cf:alphabet-mule ;
	lay:layerIndex "1"^^xsd:nonNegativeInteger ; lay:coverage "partial" ; lay:concurrencyGroup "cofer-2019" .
cf:couple a lay:Coupling ; uco-core:name "Both layers use stolen client instruments" ;
	lay:couplingKind "sharesFactor" ; lay:fromLayer cf:layer-account ; lay:toLayer cf:layer-mule ;
	prov:wasDerivedFrom cf:evidence-affidavit .
cf:machine a lay:ExploitationStateMachine ;
	uco-core:name "Cofer insider-to-account machine (v0.0.0)" ;
	uco-core:description "Elder fraud whose first affordance is a care relationship, not a call script or a website. Bank accounts, an add-on card, an ATM, and a recruited debit card carry the money. compositionPattern concurrent. completeness partial." ;
	lay:hasLayer cf:layer-account , cf:layer-mule ; lay:hasCoupling cf:couple ;
	lay:compositionPattern "concurrent" ; lay:completeness "partial" .

