# CASE/UCO context layer
# Manner of the labor conspiracy. No worker name and no street address.
#################################################################

rj:charge-doc a legalproc:ChargingInstrument ;
	uco-core:name "Indictment, United States v. Rojas" ;
	legalproc:instrumentType "indictment" ;
	uco-core:description "Filed 2025-02-19. CourtListener 458211891." ;
	prov:wasDerivedFrom rj:doc .
rj:charge-1589 a legalproc:FederalCharge ;
	uco-core:name "Forced labor" ;
	legalproc:statuteCitation "18 U.S.C. § 1589" ;
	legalproc:assertedIn rj:charge-doc .
rj:charge-1590 a legalproc:FederalCharge ;
	uco-core:name "Trafficking with respect to forced labor" ;
	legalproc:statuteCitation "18 U.S.C. § 1590" ;
	legalproc:assertedIn rj:charge-doc .
rj:person-rojas a uco-identity:Person ;
	uco-core:name "Carolina Rojas" ;
	uco-core:description "Named defendant." ;
	uco-core:tag "charging-allegation" .
rj:person-gastelo a uco-identity:Person ;
	uco-core:name "Jairo John Gastelo" ;
	uco-core:description "Named defendant. Also known as Jhon Gastelo." ;
	uco-core:tag "charging-allegation" .
rj:loc-simi a uco-location:Location ;
	uco-core:name "Residence in Simi Valley" ;
	uco-core:description "The manner alleges workers were housed at a residence in Simi Valley. No street address is recorded." ;
	uco-core:tag "charging-allegation" .
rj:workers a uco-identity:Identity , uco-victim:Victim ;
	uco-core:name "Adult workers recruited in Latin America" ;
	uco-core:description "Overt acts describe four adult workers, two from Peru and two from Venezuela. Initials are not recorded. A child mentioned in the indictment is not described." ;
	uco-core:tag "charging-allegation" .
rj:rel-house a uco-core:Relationship ;
	uco-core:isDirectional true ;
	uco-core:kindOfRelationship "housed-at" ;
	uco-core:source rj:workers ;
	uco-core:target rj:loc-simi ;
	uco-core:name "Housed at the residence" ;
	prov:wasDerivedFrom rj:evidence .
rj:act-move uco-action:performer rj:person-rojas ; uco-action:participant rj:person-gastelo ; uco-action:object rj:workers ; uco-action:location rj:loc-simi .
rj:investigation a case-investigation:Investigation ;
	uco-core:name "United States v. Rojas, C.D. Cal. 2:25-cr-110" ;
	legalproc:caseIdentifier "2:25-cr-00110" ;
	case-investigation:investigationForm "case" ;
	case-investigation:focus "Recruit, house, unpaid domestic labor" ;
	uco-core:object rj:charge-doc , rj:person-rojas , rj:person-gastelo , rj:workers , rj:loc-simi , rj:trajectory .

#################################################################
# v0.0.1 dated overt acts. No initials. The defendants' child
# is not described. Crossing details are not copied.
#################################################################

rj:loc-la a uco-location:Location ;
	uco-core:name "Los Angeles" ;
	uco-core:description "Overt acts 9, 10, and 19 place meetings to obtain fraudulent immigration documents in Los Angeles." .
rj:act-fee a uco-action:Action ;
	uco-core:name "Demand a smuggling fee" ;
	uco-core:description "Overt act 8: on 2022-04-12 each of the first two workers was told she owed $10,000. Overt act 25: on 2023-10-28 the later two were told they owed at least $5,000." ;
	uco-action:startTime "2022-04-12T00:00:00Z"^^xsd:dateTime ;
	uco-action:performer rj:person-rojas ;
	prov:wasDerivedFrom rj:evidence .
rj:act-docs a uco-action:Action ;
	uco-core:name "Obtain fraudulent immigration documents" ;
	uco-core:description "April 2022, Los Angeles: fraudulent Social Security and permanent-resident cards, $200 paid for each of the first two workers. September 2023: a fraudulent permanent-resident card, $150. No document number is recorded." ;
	uco-action:startTime "2022-04-01T00:00:00Z"^^xsd:dateTime ;
	uco-action:performer rj:person-rojas ;
	uco-action:location rj:loc-la ;
	prov:wasDerivedFrom rj:evidence .
rj:act-outside a uco-action:Action ;
	uco-core:name "Place a worker at a Simi Valley restaurant and cash the pay" ;
	uco-core:description "May 2022 for the first two workers, and September–October 2023 for a later worker. The indictment names the restaurant and a check-cashing business. The brand is not copied. The pay is alleged as the means of paying the smuggling fee." ;
	uco-action:startTime "2022-05-01T00:00:00Z"^^xsd:dateTime ;
	uco-action:performer rj:person-rojas ;
	uco-action:location rj:loc-simi ;
	prov:wasDerivedFrom rj:evidence .
rj:act-move uco-action:subaction rj:exec-arrive-2021-12 , rj:exec-arrive-2022-04 , rj:exec-arrive-2023-07 , rj:exec-arrive-2023-10 .
rj:exec-arrive-2021-12 a uco-action:Action ;
	uco-core:name "First worker arrives, 2021-12-22" ;
	uco-core:description "Overt acts 1–4. Recruited in November 2021 from Peru. On 2021-12-22 a ticket paid by Rojas, then transport to the residence, then a requirement of domestic labor described as the household's work. The child is not described." ;
	uco-action:startTime "2021-12-22T00:00:00Z"^^xsd:dateTime ;
	uco-action:location rj:loc-simi ;
	prov:wasDerivedFrom rj:evidence .
rj:exec-arrive-2022-04 a uco-action:Action ;
	uco-core:name "Second worker arrives, 2022-04-12" ;
	uco-core:description "Overt acts 5–8. Recruited in April 2022 from Peru. On 2022-04-12 a ticket paid by Rojas, transport to the residence, and a statement that labor would be required in exchange for rent. The same day each of the two was told she owed $10,000." ;
	uco-action:startTime "2022-04-12T00:00:00Z"^^xsd:dateTime ;
	uco-action:location rj:loc-simi ;
	prov:wasDerivedFrom rj:evidence .
rj:exec-arrive-2023-07 a uco-action:Action ;
	uco-core:name "Third worker arrives, July 2023" ;
	uco-core:description "Overt acts 15–17. A ticket paid by Rojas, then a requirement of domestic labor at the residence. The worker is described as a Venezuelan national. Initials are not recorded." ;
	uco-action:startTime "2023-07-01T00:00:00Z"^^xsd:dateTime ;
	uco-action:location rj:loc-simi ;
	prov:wasDerivedFrom rj:evidence .
rj:exec-arrive-2023-10 a uco-action:Action ;
	uco-core:name "Fourth worker arrives, 2023-10-28" ;
	uco-core:description "Overt acts 22–25. A ticket paid by Rojas in October 2023. On 2023-10-28 domestic labor was required, and the later pair were told they owed at least $5,000. Initials are not recorded." ;
	uco-action:startTime "2023-10-28T00:00:00Z"^^xsd:dateTime ;
	uco-action:location rj:loc-simi ;
	prov:wasDerivedFrom rj:evidence .
rj:e1 traj:enactsAction rj:act-fee , rj:act-docs .
rj:e2 traj:enactsAction rj:act-outside .
